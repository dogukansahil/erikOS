# Local build environment: virtual disks, the private signing key, caches,
# generated APT tree. Only its README is part of the repository.
build-environment/*
!build-environment/README.md

# Release files go to GitHub Releases, never into git.
releases/
*.iso
*.img
*.vdi
*.vhdx
*.vmdk

# live-build output when building by hand
binary/
cache/
chroot/
.build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/

# Editors and operating systems
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
