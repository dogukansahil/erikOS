"""erik-theme-gui: graphical Erik OS appearance settings (GTK 4, libadwaita)."""

import argparse
import os
import sys
from pathlib import Path

APP_ID = "org.genotomi.ErikTheme"
BACKGROUNDS = Path("/usr/share/backgrounds/erik")
THUMBNAIL_WIDTH = 240
THUMBNAIL_HEIGHT = 150
CMDLINE = Path("/proc/cmdline")

# Keys the "Restore Erik defaults" button resets: exactly the keys the
# erik-theme command resets, plus the colour scheme. Keep in sync with
# MANAGED_KEYS in /usr/bin/erik-theme.
RESET_KEYS = (
    ("org.gnome.desktop.background", "picture-uri"),
    ("org.gnome.desktop.background", "picture-uri-dark"),
    ("org.gnome.desktop.background", "picture-options"),
    ("org.gnome.desktop.background", "primary-color"),
    ("org.gnome.desktop.screensaver", "picture-uri"),
    ("org.gnome.desktop.screensaver", "picture-options"),
    ("org.gnome.desktop.screensaver", "primary-color"),
    ("org.gnome.desktop.interface", "accent-color"),
    ("org.gnome.desktop.interface", "color-scheme"),
)

COLOR_SCHEMES = ("default", "prefer-light", "prefer-dark")

# Display names that differ from the file name (same as erik-backgrounds.xml).
WALLPAPER_TITLES = {"pen": "Blueprint"}

# GNOME accent colour names and the swatch colours shown on the buttons.
ACCENTS = (
    ("blue", "#3584e4"),
    ("teal", "#2190a4"),
    ("green", "#3a944a"),
    ("yellow", "#c88800"),
    ("orange", "#ed5b00"),
    ("red", "#e62d42"),
    ("pink", "#d56199"),
    ("purple", "#9141ac"),
    ("slate", "#6f8396"),
)

# Human-readable text in the four Erik OS languages.
