"""erik-theme: list, apply and reset Erik OS appearance settings."""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "0.2.0"
BACKGROUNDS = Path("/usr/share/backgrounds/erik")
DEFAULT_BACKGROUND = "dark"

# Keys erik-theme manages. "reset" returns exactly these to the system default.
MANAGED_KEYS = (
    ("org.gnome.desktop.background", "picture-uri"),
    ("org.gnome.desktop.background", "picture-uri-dark"),
    ("org.gnome.desktop.background", "picture-options"),
    ("org.gnome.desktop.background", "primary-color"),
    ("org.gnome.desktop.screensaver", "picture-uri"),
    ("org.gnome.desktop.screensaver", "picture-options"),
    ("org.gnome.desktop.screensaver", "primary-color"),
    ("org.gnome.desktop.interface", "accent-color"),
)

# Human-readable text in the four Erik OS languages. Command names, JSON
# field names and exit codes stay the same in every language.
MESSAGES = {
    "en": {
        "description": "List, apply and reset Erik OS appearance settings.",
        "list": "list installed Erik wallpapers",
        "set": "use a wallpaper for the desktop and lock screen",
        "reset": "return all Erik appearance settings to the system default",
        "json": "print machine-readable JSON",
        "name": "wallpaper name, for example: dark",
        "current": "current",
        "applied": "Wallpaper set: {name}",
        "reset_done": "Erik appearance settings returned to the system default.",
        "unknown": "Unknown wallpaper: {name}. Run 'erik-theme list' to see the choices.",
        "no_gsettings": "gsettings was not found. Install the libglib2.0-bin package.",
        "no_session": "No desktop session found. Run this command as the desktop user, not with sudo.",
        "failed": "Could not change the setting: {error}",
    },
    "de": {
        "description": "Erik-OS-Darstellung anzeigen, anwenden und zurücksetzen.",
