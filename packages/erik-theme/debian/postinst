#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
set -e

# Erik's logo wherever the vendor logo is shown (GDM login screen and
# others). Debian's desktop-base registers the same alternative with
# priority 50; Erik uses 100. Removing erik-theme brings Debian's back.
if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-remove ]; then
    logos=/usr/share/erik/vendor-logos
    update-alternatives --install /usr/share/images/vendor-logos vendor-logos "$logos" 100 \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor.png emblem-vendor-64 "$logos/logo-64.png" \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor.png emblem-vendor-128 "$logos/logo-128.png" \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor.png emblem-vendor-256 "$logos/logo-256.png"
fi

#DEBHELPER#

exit 0
