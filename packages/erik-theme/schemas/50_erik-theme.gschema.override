# Erik OS appearance defaults. Users can still change every key.
# Per-user changes: erik-theme set <name> / erik-theme reset

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/erik/dark.jpg'
picture-uri-dark='file:///usr/share/backgrounds/erik/dark.jpg'
picture-options='zoom'
primary-color='#1d2321'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/erik/dark.jpg'
picture-options='zoom'
primary-color='#1d2321'

[org.gnome.desktop.interface]
accent-color='green'
