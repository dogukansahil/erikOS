// SPDX-License-Identifier: GPL-3.0-only
// Erik OS system-wide fastfetch defaults: the Erik ASCII logo in Erik green.
// Users can override this with ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/erik/artwork/erik-logo-fastfetch.txt",
    "color": { "1": "green" },
    "padding": { "right": 3, "top": 1 }
  },
  "display": {
    "color": { "keys": "green" }
  },
  // A config file replaces fastfetch's built-in module list, so it is listed here.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
